---
import Base from '../../../layouts/Base.astro';
import { RATGEBER_KATEGORIEN } from '../../../config/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return RATGEBER_KATEGORIEN.map((k) => ({ params: { kategorie: k.slug }, props: { kategorie: k } }));
}

const { kategorie } = Astro.props;
const artikel = await getCollection('ratgeber', (a) => !a.data.entwurf && a.data.kategorie === kategorie.slug);
---
<Base
  titel={`${kategorie.titel} | Voxera Ratgeber`}
  beschreibung={`Artikel zum Thema ${kategorie.titel} für Schweizer KMU – praxisnah und ohne Fachjargon.`}
  noindex={artikel.length === 0}
>
  <section class="sektion">
    <div class="wrap">
      <hr class="akzentlinie" />
      <h1>{kategorie.titel}</h1>
      {artikel.length === 0 ? (
        <p class="leise">
          Noch keine Artikel in dieser Kategorie. Die Seite steht bis dahin auf
          <code> noindex</code>, damit keine leere Kategorie indexiert wird.
        </p>
      ) : (
        <ul role="list">
          {artikel.map((a) => <li><a href={`/ratgeber/${a.slug}/`}>{a.data.titel}</a></li>)}
        </ul>
      )}
    </div>
  </section>
</Base>
