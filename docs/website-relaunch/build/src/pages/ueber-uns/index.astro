---
import Base from '../../layouts/Base.astro';
import Platzhalter from '../../components/Platzhalter.astro';
---
<Base
  titel="Über Voxera | KI-Telefonassistent aus der Schweiz"
  beschreibung="Wer hinter Voxera steht, wo wir sitzen und warum ein Schweizer KMU seinen Telefonempfang automatisieren sollte."
>
  <section class="sektion">
    <div class="wrap">
      <hr class="akzentlinie" />
      <h1>Über Voxera</h1>
      <Platzhalter
        was="Gründerprofil und Standortabschnitt"
        wartetAuf="Text und Bild"
      />
      <p class="leise" style="margin-top:20px;font-size:var(--vx-text-sm);">
        Diese Seite trägt einen Teil des Vertrauens, das sonst Kundenstimmen tragen würden –
        solange es keine freigegebenen Referenzen gibt, zählt hier Transparenz.
      </p>
    </div>
  </section>
</Base>
