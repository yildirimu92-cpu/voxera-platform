---
import Base from '../../layouts/Base.astro';
import Platzhalter from '../../components/Platzhalter.astro';
---
<Base
  titel="Demo und kostenloses Erstgespräch | Voxera"
  beschreibung="Hören Sie, wie Voxera ans Telefon geht, und buchen Sie ein 15-minütiges Erstgespräch – kostenlos und unverbindlich."
>
  <section class="sektion">
    <div class="wrap">
      <hr class="akzentlinie" />
      <h1>Demo und Erstgespräch</h1>
      <Platzhalter was="Demo-Aufnahme und Terminbuchung" wartetAuf="Einbindung der bestehenden Calendly-Strecke" />
    </div>
  </section>
</Base>
